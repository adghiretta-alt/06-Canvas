<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.Controller">
    <children>

        <!-- Esquerra: Àrea de dibuix -->
        <Canvas fx:id="canvas" width="600.0" height="500.0" />

        <!-- Centre: Eines i Formularis -->
        <VBox spacing="8.0" prefWidth="180.0" style="-fx-background-color: #eeeeee;">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <!-- Eines -->
                <Label text="Eina" style="-fx-font-weight: bold;" />
                <fx:define>
                    <ToggleGroup fx:id="toolGroup" />
                </fx:define>
                <RadioButton fx:id="freehandRadio" text="Traç lliure" toggleGroup="$toolGroup" selected="true" />
                <RadioButton fx:id="lineRadio" text="Línia" toggleGroup="$toolGroup" />
                <RadioButton fx:id="rectRadio" text="Rectangle" toggleGroup="$toolGroup" />

                <Separator />

                <!-- Opcions de dibuix -->
                <Label text="Estil" style="-fx-font-weight: bold;" />
                <Label text="Color contorn:" />
                <ColorPicker fx:id="strokeColorPicker" maxWidth="1.7976931348623157E308" />

                <Label text="Color emplenament:" />
                <ColorPicker fx:id="fillColorPicker" maxWidth="1.7976931348623157E308" />

                <Label text="Ample de línia:" />
                <Spinner fx:id="widthSpinner" maxWidth="1.7976931348623157E308" />

                <Region VBox.vgrow="ALWAYS" />
                <Separator />

                <!-- Bottom: Colors predefinits -->
                <Label text="Colors predefinits" style="-fx-font-weight: bold;" />
                <Canvas fx:id="colorsCanvas" width="160.0" height="60.0" />
            </children>
        </VBox>

        <!-- Dreta: Llista d'objectes i botó d'eliminar -->
        <VBox prefWidth="180.0" spacing="10.0">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <Label text="Objectes dibuixats" style="-fx-font-weight: bold;" />
                <ListView fx:id="objectsListView" VBox.vgrow="ALWAYS" />
                <Button fx:id="deleteButton" text="Eliminar" disable="true" maxWidth="1.7976931348623157E308" onAction="#onDeleteSelected" />
            </children>
        </VBox>

    </children>
</HBox>